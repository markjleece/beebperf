+// Read and write memory helpers - used for performance capture - MJSL
+
+static int LastReadWriteAddress;
+static unsigned char LastReadValue;
+static unsigned char LastWriteValue;
+
+inline static unsigned char ReadZeroPage(int address)
+{
+	LastReadWriteAddress = address;
+	LastReadValue = WholeRam[address];
+	return LastReadValue;
+}
+
+inline static void WriteZeroPage(int address, unsigned char value)
+{
+	LastReadWriteAddress = address;
+	LastWriteValue = value;
+	WholeRam[address] = value;
+}
+
+inline static unsigned char ReadPaged(int address)
+{
+	LastReadWriteAddress = address;
+	LastReadValue = BeebReadMem(address);
+	return LastReadValue;
+}
+
+inline static void WritePaged(int address, unsigned char value)
+{
+	LastReadWriteAddress = address;
+	LastWriteValue = value;
+	BeebWriteMem(address, value);
+}
+
+/*----------------------------------------------------------------------------*/
+
+// Call stack - used for performance capture - MJSL
+
+static StackFrame StackFrames[128];
+static int StackFrameCount;
+
+static void SetStackFrame(int index, StackFrameType type, int startAddress, int returnAddress, unsigned char returnStackReg)
+{
+	StackFrame* stackFrame = &StackFrames[index];
+	stackFrame->Type = type;
+	stackFrame->StartAddressPage = BeebMemPage(startAddress);
+	stackFrame->StartAddress = startAddress;
+	stackFrame->ReturnAddressPage = BeebMemPage(returnAddress);
+	stackFrame->ReturnAddress = returnAddress;
+	stackFrame->ReturnStackReg = returnStackReg;
+}
+
+static void SyncStackFrames(unsigned char stackReg)
+{
+	while (stackReg >= StackFrames[StackFrameCount - 1].ReturnStackReg && StackFrameCount > 1)
+	{
+		StackFrameCount--;
+	}
+}
+
+inline static void PushStackFrame(StackFrameType type, int returnAddress, unsigned char returnStackReg)
+{
+	SyncStackFrames(returnStackReg);
+	SetStackFrame(StackFrameCount++, type, ProgramCounter, returnAddress, returnStackReg);
+}
+
+inline static void UpdateRootStackFrame()
+{
+	if (PrePC > 0x8000 && ProgramCounter < 0x8000 && StackFrames[0].StartAddress >= 0x8000)
+	{
+		SetStackFrame(0/*index*/, StackFrameType_Root, ProgramCounter, 0/*returnAddress*/, 0xff/*returnStackReg*/);
+	}
+}
+
+void GetStackFrames(const StackFrame** ppStackFrames, int* pStackFrameCount)
+{
+	SyncStackFrames(StackReg);
+	*pStackFrameCount = StackFrameCount;
+	*ppStackFrames = StackFrames;
+}
+
+/*----------------------------------------------------------------------------*/
+
+// Get registers - used for performance capture - MJSL
+
+void GetRegisters(int* pProgramCounter, unsigned char* pAccumulator, unsigned char* pXReg, unsigned char* pYReg, unsigned char* pPSR, unsigned char* pStackReg)
+{
+	*pProgramCounter = ProgramCounter;
+	*pAccumulator = Accumulator;
+	*pXReg = XReg;
+	*pYReg = YReg;
+	*pPSR = PSR;
+	*pStackReg = StackReg;
+}
