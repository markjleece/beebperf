+//
+// File IO helpers
+//
+
+inline static FILE* FileOpen(const CHAR* psFileName)
+{
+	FILE* pFile = fopen(psFileName, "wb");
+	if (pFile == NULL)
+	{
+		throw std::exception(strerror(errno));
+	}
+	return pFile;
+}
+
+inline static void FileClose(FILE** pFile)
+{
+	if (*pFile != nullptr)
+	{
+		fclose(*pFile);
+		*pFile = nullptr;
+	}
+}
+
+inline static void FileWrite(FILE* pFile, const void* data, size_t size)
+{
+	if (fwrite(data, size, 1/*elementCount*/, pFile) != 1)
+	{
+		throw std::exception(strerror(errno));
+	}
+}
+
+inline static void FileWriteByte(FILE* pFile, byte value)
+{
+	FileWrite(pFile, &value, sizeof(value));
+}
+
+inline static void FileWriteInt32(FILE* pFile, int32_t value)
+{
+	FileWrite(pFile, &value, sizeof(value)); // Assumes little endian host architecture
+}
