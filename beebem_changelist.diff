+void PerfWriter::CreateResources()
+{
+	InitializeCriticalSection(&m_cs);
+
+	// Create events
+	m_hStartupEvent = CreateEvent(nullptr, TRUE, FALSE, nullptr);
+	if (m_hStartupEvent == NULL)
+	{
+		throw std::exception("CreateEvent failed!");
+	}
+
+	m_hShutdownEvent = CreateEvent(nullptr, TRUE, FALSE, nullptr);
+	if (m_hShutdownEvent == NULL)
+	{
+		throw std::exception("CreateEvent failed!");
+	}
+
+	m_hReadBufferReadyEvent = CreateEvent(nullptr, TRUE, FALSE, nullptr);
+	if (m_hReadBufferReadyEvent == NULL)
+	{
+		throw std::exception("CreateEvent failed!");
+	}
+
+	m_hReadBufferConsumedEvent = CreateEvent(nullptr, TRUE, TRUE/*signaled*/, nullptr);
+	if (m_hReadBufferConsumedEvent == NULL)
+	{
+		throw std::exception("CreateEvent failed!");
+	}
+
+	// Create thread, waiting for it to startup
+	unsigned int threadId = 0;
+	m_hThread = (HANDLE)_beginthreadex(nullptr, 0, ThreadFunc, this, 0, &threadId);
+	if (m_hThread == NULL)
+	{
+		throw std::exception("CreateThread failed!");
+	}
+
+	WaitForSingleObject(m_hStartupEvent, INFINITE);
+}
+
+void PerfWriter::DestroyResources()
+{
+	// Close thread
+	if (m_hThread != NULL)
+	{
+		if (m_hShutdownEvent != NULL)
+		{
+			SetEvent(m_hShutdownEvent);
+			WaitForSingleObject(m_hThread, INFINITE);
+		}
+		CloseHandle(m_hThread);
+		m_hThread = NULL;
+	}
+
+	// Close events
+	if (m_hStartupEvent != NULL)
+	{
+		CloseHandle(m_hStartupEvent);
+		m_hStartupEvent = NULL;
+	}
+
+	if (m_hShutdownEvent != NULL)
+	{
+		CloseHandle(m_hShutdownEvent);
+		m_hShutdownEvent = NULL;
+	}
+
+	if (m_hReadBufferReadyEvent != NULL)
+	{
+		CloseHandle(m_hReadBufferReadyEvent);
+		m_hReadBufferReadyEvent = NULL;
+	}
+
+	if (m_hReadBufferConsumedEvent != NULL)
+	{
+		CloseHandle(m_hReadBufferConsumedEvent);
+		m_hReadBufferConsumedEvent = NULL;
+	}
+
+	DeleteCriticalSection(&m_cs);
+}
+
+void PerfWriter::WriteHeaderChunk()
+{
+	Buffer headerData(7);
+
+	byte version[] = { 2, 0 };
+	headerData.Write(version, sizeof(version));
+
+	byte bbcModel = 0;
+	switch (MachineType)
+	{
+	case Model::B:
+		bbcModel = 0;
+		break;
+	case Model::IntegraB:
+		bbcModel = 1;
+		break;
+	case Model::BPlus:
+		bbcModel = 2;
+		break;
+	case Model::Master128:
+		bbcModel = 3;
+		break;
+	case Model::MasterET:
+		bbcModel = 4;
+		break;
+	}
+	headerData.WriteByte(bbcModel);
+
+	headerData.WriteInt32(0); // Execution count placeholder (updated when capture ends)
+
+	WriteFileChunk("PFhd", false/*compressed*/, headerData);
+}
+
+void PerfWriter::WriteLabelsChunk()
+{
+	int length = 0;
+	for (int i = 0; i < Labels.size(); i++)
+	{
+		const Label& label = Labels[i];
+		length += 2/*address*/ + (int)label.name.length() + 1/*null-terminator*/;
+	}
+
+	Buffer labelData(length);
+
+	for (int i = 0; i < Labels.size(); i++)
+	{
+		const Label& label = Labels[i];
+		labelData.WriteInt16((int16_t)label.addr);
+		labelData.Write(label.name.c_str(), (int)label.name.length() + 1);
+	}
+
+	WriteFileChunk("PFlb", true/*compressed*/, labelData);
+}
+
+void PerfWriter::WriteSnapshotChunk()
+{
+	// Calculate snapshot size
+	bool bShadowRAM = (MachineType == Model::BPlus || MachineType == Model::IntegraB || MachineType == Model::Master128 || MachineType == Model::MasterET);
+	bool bPrivateRAM = (MachineType == Model::BPlus || MachineType == Model::IntegraB);
+	bool bPrivateMosRAM = (MachineType == Model::Master128 || MachineType == Model::MasterET);
+	bool bFilingSystemRAM = (MachineType == Model::Master128 || MachineType == Model::MasterET);
+	bool bHiddenRAM = (MachineType == Model::IntegraB);
+
+	int bankCount = 0;
+	for (int bank = 0; bank < ROM_BANK_COUNT; bank++)
+	{
+		BankType bankType = RomBankType[bank];
+		bankCount += (int)(bankType == BankType::Rom || bankType == BankType::Ram);
+	}
+
+	int snapshotSize =
+		7 +                             // CPU registers
+		2 +                             // Paging registers
+		(bHiddenRAM ? 1 : 0) +          // Hidden ram address (IntegraB)
+		17 +                            // Video ULA registers
+		19 +                            // CRTC registers
+		1 +                             // Screen wrap address
+		1 + m_stackFrameCount * 8 +     // Call stack
+		65536 +                         // Base memory (64K)
+		1 +                             // Memory page count
+		bankCount * (2 + 16384) +       // Memory page data (bank-id, read-only flag, memory (16K))
+		(bShadowRAM ? 20480 : 0) +      // Shadow ram (20K)
+		(bPrivateRAM ? 12288 : 0) +     // Private ram (12K)
+		(bPrivateMosRAM ? 4096 : 0) +   // Private ram (4K)
+		(bFilingSystemRAM ? 8192 : 0) + // Filing system ram (8K)
+		(bHiddenRAM ? 256 : 0);         // Hidden ram (256-bytes)
+
+	Buffer snapshotData(snapshotSize);
+
+	// CPU registers
+	snapshotData.WriteInt16((int16_t)m_programCounter);
+	snapshotData.WriteByte(m_accumulator);
+	snapshotData.WriteByte(m_XRegister);
+	snapshotData.WriteByte(m_YRegister);
+	snapshotData.WriteByte(m_statusRegister);
+	snapshotData.WriteByte(m_stackRegister);
+
+	// Paging registers
+	byte pagedRomReg = PagedRomReg;
+	byte acccon = ACCCON;
+
+	if (MachineType == Model::BPlus)
+	{
+		pagedRomReg |= (int)MemSel << 7;
+		acccon = (int)Sh_Display << 7;
+	}
+	else if (MachineType == Model::IntegraB)
+	{
+		pagedRomReg |= (int)MemSel << 7 | (int)PrvEn << 6;
+		acccon = (int)ShEn << 7 | (int)Prvs8 << 6 | (int)Prvs4 << 5 | (int)Prvs1 << 4;
+	}
+
+	snapshotData.WriteByte(pagedRomReg);
+	snapshotData.WriteByte(acccon);
+
+	// Hidden RAM address
+	if (bHiddenRAM)
+	{
+		snapshotData.WriteByte((byte)HidAdd);
+	}
+
+	// Video ULA registers
+	snapshotData.WriteByte(VideoULA_ControlReg);
+	for (int i = 0; i < 16; i++)
+	{
+		snapshotData.WriteByte(VideoULA_Palette[i]);
+	}
+
+	// CRTC registers
+	snapshotData.WriteByte(CRTCControlReg);
+	snapshotData.WriteByte(CRTC_HorizontalTotal);
+	snapshotData.WriteByte(CRTC_HorizontalDisplayed);
+	snapshotData.WriteByte(CRTC_HorizontalSyncPos);
+	snapshotData.WriteByte(CRTC_SyncWidth);
+	snapshotData.WriteByte(CRTC_VerticalTotal);
+	snapshotData.WriteByte(CRTC_VerticalTotalAdjust);
+	snapshotData.WriteByte(CRTC_VerticalDisplayed);
+	snapshotData.WriteByte(CRTC_VerticalSyncPos);
+	snapshotData.WriteByte(CRTC_InterlaceAndDelay);
+	snapshotData.WriteByte(CRTC_ScanLinesPerChar);
+	snapshotData.WriteByte(CRTC_CursorStart);
+	snapshotData.WriteByte(CRTC_CursorEnd);
+	snapshotData.WriteByte(CRTC_ScreenStartHigh);
+	snapshotData.WriteByte(CRTC_ScreenStartLow);
+	snapshotData.WriteByte(CRTC_CursorPosHigh);
+	snapshotData.WriteByte(CRTC_CursorPosLow);
+	snapshotData.WriteByte(CRTC_LightPenHigh);
+	snapshotData.WriteByte(CRTC_LightPenLow);
+
+	// Screen wrap address (B5 & B4 of System-VIA Port B addressable latch)
+	snapshotData.WriteByte((IC32State & 0x30) >> 4);
+
+	// Call stack
+	snapshotData.WriteByte((byte)m_stackFrameCount);
+	for (int i = 0; i < m_stackFrameCount; i++)
+	{
+		const StackFrame* stackFrame = &m_stackFrames[i];
+		snapshotData.WriteByte((byte)stackFrame->Type);
+		snapshotData.WriteByte((byte)stackFrame->StartAddressPage);
+		snapshotData.WriteInt16((int16_t)stackFrame->StartAddress);
+		snapshotData.WriteByte((byte)stackFrame->ReturnAddressPage);
+		snapshotData.WriteInt16((int16_t)stackFrame->ReturnAddress);
+		snapshotData.WriteByte(stackFrame->ReturnStackReg);
+	}
+
+	// Memory
+	snapshotData.Write(WholeRam, 65536);
+
+	snapshotData.WriteByte((byte)bankCount);
+	for (int bank = 0; bank < ROM_BANK_COUNT; bank++)
+	{
+		BankType bankType = RomBankType[bank];
+		if (bankType == BankType::Rom || bankType == BankType::Ram)
+		{
+			snapshotData.WriteByte((byte)bank);
+			snapshotData.WriteByte((byte)(bankType == BankType::Rom));
+			snapshotData.Write(Roms[bank], 16384);
+		}
+	}
+
+	if (bShadowRAM)
+	{
+		if (MachineType == Model::BPlus || MachineType == Model::Master128 || MachineType == Model::MasterET)
+			snapshotData.Write(ShadowRAM + 12288, 20480);
+		else if (MachineType == Model::IntegraB)
+			snapshotData.Write(ShadowRam, 20480);
+	}
+
+	if (bPrivateRAM)
+	{
+		snapshotData.Write(Private, 12288);
+	}
+
+	if (bPrivateMosRAM)
+	{
+		snapshotData.Write(PrivateRAM, 4096);
+	}
+
+	if (bFilingSystemRAM)
+	{
+		snapshotData.Write(FSRam, 8192);
+	}
+
+	if (bHiddenRAM)
+	{
+		snapshotData.Write(Hidden, 256);
+	}
+
+	WriteFileChunk("PFss", true/*compressed*/, snapshotData);
+}
+
+void PerfWriter::WriteFileChunk(const char* chunkTag, bool compressed, const PerfWriter::Buffer& buffer)
+{
+	AutoLock lock(&m_cs);
+
+	assert(strlen(chunkTag) == 4);
+
+	int outputSize = buffer.Size();
+	const byte* outputData = buffer.Data();
+
+	// Compress buffer
+	if (compressed) 
+	{
+		static byte compressedData[BufferSize];
+
+		z_stream deflateStream;
+		memset(&deflateStream, 0, sizeof(deflateStream));
+
+		deflateStream.zalloc = Z_NULL;
+		deflateStream.zfree = Z_NULL;
+		deflateStream.opaque = Z_NULL;
+		deflateStream.avail_in = (uInt)buffer.Size();
+		deflateStream.next_in = (byte*)buffer.Data();
+		deflateStream.avail_out = (uInt)BufferSize;
+		deflateStream.next_out = compressedData;
+
+		if (deflateInit(&deflateStream, Z_DEFAULT_COMPRESSION) != Z_OK)
+		{
+			throw std::exception("deflateInit failed!");
+		}
+
+		int ret = deflate(&deflateStream, Z_FINISH);
+		if (ret != Z_STREAM_END && ret != Z_OK && ret != Z_BUF_ERROR)
+		{
+			// Error!
+			std::string error = "deflate failed with error";
+			if (deflateStream.msg)
+			{
+				error.append(": ");
+				error.append(deflateStream.msg);
+			}
+			deflateEnd(&deflateStream);
+			throw std::exception(error.c_str());
+		}
+
+		compressed = (ret == Z_STREAM_END);
+		if (compressed)
+		{
+			outputSize = deflateStream.total_out;
+			outputData = compressedData;
+		}
+
+		deflateEnd(&deflateStream);
+	}
+
+	// Write chunk header to file
+	FileWrite(m_pFile, chunkTag, strlen(chunkTag));
+	FileWriteByte(m_pFile, (byte)compressed);
+	FileWriteInt32(m_pFile, buffer.Size()); // Original size
+	FileWriteInt32(m_pFile, outputSize);    // Compressed size
+
+	// Write chunk data to file
+	FileWrite(m_pFile, outputData, outputSize);
+}
+
+void PerfWriter::WriteFrameStartEvent(int offsetCycleCount, int startAddress, int displayScanline, byte displayField, bool splitScreen)
+{
+	if (m_pFile == nullptr || m_error) return;
+
+	if (m_writeBuffer->Size() >= (BufferSize - FrameStartEventSize)) // Buffer almost full?
+	{
+		// Swap read / write buffers
+		if (!SwapReadWriteBuffers()) return;
+	}
+
+	// Write frame start event marker (0x80, 0x02)
+	m_writeBuffer->WriteByteUnchecked(0x80);
+	m_writeBuffer->WriteByteUnchecked(0x02);
+
+	// Write offset cycles
+	m_writeBuffer->WriteByteUnchecked((byte)offsetCycleCount);
+
+	// Write start address
+	m_writeBuffer->WriteByteUnchecked((byte)(startAddress & 0xFF));
+	m_writeBuffer->WriteByteUnchecked((byte)(startAddress >> 8));
+
+	// Write display scanline
+	m_writeBuffer->WriteByteUnchecked((byte)(displayScanline & 0xFF));
+	m_writeBuffer->WriteByteUnchecked((byte)(displayScanline >> 8));
+
+	// Write display flags
+	byte displayFlags = 0;
+	if (displayField) displayFlags |= 0x01;
+	if (splitScreen) displayFlags |= 0x02;
+	m_writeBuffer->WriteByteUnchecked(displayFlags);
+
+	m_executionCount++;
+}
+
+void PerfWriter::WriteInterruptEvent(
+	PerfWriter::InterruptType interruptType, int prePC, int postPC, byte cycleCount, byte stackStatusRegister)
+{
+	if (m_pFile == nullptr || m_error) return;
+
+	if (m_writeBuffer->Size() >= (BufferSize - InterruptEventSize)) // Buffer almost full?
+	{
+		// Swap read / write buffers
+		if (!SwapReadWriteBuffers()) return;
+	}
+
+	// Write maskable or non-maskable interrupt marker (0x80, 0|1)
+	m_writeBuffer->WriteByteUnchecked(0x80);
+	m_writeBuffer->WriteByteUnchecked((byte)interruptType);
+
+	// Write cycle count
+	m_writeBuffer->WriteByteUnchecked((byte)cycleCount);
+
+	// Write destination address
+	m_writeBuffer->WriteByteUnchecked((byte)(postPC & 0xFF));
+	m_writeBuffer->WriteByteUnchecked((byte)(postPC >> 8));
+
+	// Write pushed return address
+	m_writeBuffer->WriteByteUnchecked((byte)(prePC & 0xFF));
+	m_writeBuffer->WriteByteUnchecked((byte)(prePC >> 8));
+
+	// Stack status register
+	m_writeBuffer->WriteByteUnchecked(stackStatusRegister);
+
+	m_executionCount++;
+}
+
+void PerfWriter::WriteInstruction(
+	int prePC, int postPC, byte opcode, byte cycleCount, 
+	byte postAccumulator, byte postXReg, byte postYReg, byte postPSR, byte postStackReg,
+	int memoryAddress, byte memoryReadValue, byte memoryWriteValue)
+{
+	if (m_pFile == nullptr || m_error) return;
+
+	if (m_writeBuffer->Size() >= (BufferSize - MaxInstructionSize)) // Buffer almost full?
+	{
+		// Swap read / write buffers
+		if (!SwapReadWriteBuffers()) return;
+	}
+
+	// Get opcode's traits
+	const OpcodeTraits opcodeTraits = m_opcodeTraitsTable[opcode];
+
+	// Write opcode address (prePC) in compressed form if possible
+	int diff = prePC - m_lastOpcodeAddress;
+	m_lastOpcodeAddress = prePC;
+	if (abs(diff) <= 63)
+	{
+		byte value = (byte)(diff + 0xC0);
+		assert(value > 0x80);
+		m_writeBuffer->WriteByteUnchecked(value);
+	}
+	else
+	{
+		if (prePC >= 0x8000)
+		{
+			m_writeBuffer->WriteByteUnchecked(0x80);
+		}
+
+		// Big-endian encoding
+		m_writeBuffer->WriteByteUnchecked((byte)(prePC >> 8));
+		m_writeBuffer->WriteByteUnchecked((byte)prePC);
+	}
+
+	// Write opcode
+	m_writeBuffer->WriteByteUnchecked(opcode);
+
+	// Write operand
+	byte operand1 = 0;
+	if (opcodeTraits.Size > 1)
+	{
+		operand1 = BeebReadMem(prePC + 1);
+		m_writeBuffer->WriteByteUnchecked(operand1);
+	}
+
+	byte operand2 = 0;
+	if (opcodeTraits.Size > 2)
+	{
+		operand2 = BeebReadMem(prePC + 2);
+		m_writeBuffer->WriteByteUnchecked(operand2);
+	}
+
+	// Calculate modified registers flags
+	byte modifiedRegisters = 0;
+	if (postAccumulator != m_accumulator)
+	{
+		modifiedRegisters |= ModifiedRegister::Accumulator;
+	}
+
+	if (postXReg != m_XRegister)
+	{
+		modifiedRegisters |= ModifiedRegister::XRegister;
+	}
+
+	if (postYReg != m_YRegister)
+	{
+		modifiedRegisters |= ModifiedRegister::YRegister;
+	}
+
+	if (postPSR != m_statusRegister)
+	{
+		modifiedRegisters |= ModifiedRegister::StatusRegister;
+	}
+
+	if (postStackReg != m_stackRegister)
+	{
+		modifiedRegisters |= ModifiedRegister::StackPointer;
+	}
+
+	// Write encoded cycle count and modified registers flags. Encoded cycle count in low 3-bits 
+	// and modified register flags in high 5-bits. A cycle count > 7 is encoded as zero and the
+	// value is written in the next byte
+	byte encodedCycleCount = (cycleCount >= 1 && cycleCount <= 7) ? cycleCount : 0;
+	m_writeBuffer->WriteByteUnchecked(encodedCycleCount | modifiedRegisters);
+	if (encodedCycleCount == 0)
+	{
+		m_writeBuffer->WriteByteUnchecked(cycleCount);
+	}
+
+	// Update / write modified registers
+	if (modifiedRegisters & ModifiedRegister::Accumulator)
+	{
+		m_accumulator = postAccumulator;
+		m_writeBuffer->WriteByteUnchecked(postAccumulator);
+	}
+
+	if (modifiedRegisters & ModifiedRegister::XRegister)
+	{
+		m_XRegister = postXReg;
+		m_writeBuffer->WriteByteUnchecked(postXReg);
+	}
+
+	if (modifiedRegisters & ModifiedRegister::YRegister)
+	{
+		m_YRegister = postYReg;
+		m_writeBuffer->WriteByteUnchecked(postYReg);
+	}
+
+	if (modifiedRegisters & ModifiedRegister::StatusRegister)
+	{
+		m_statusRegister = postPSR;
+		m_writeBuffer->WriteByteUnchecked(postPSR);
+	}
+
+	if (modifiedRegisters & ModifiedRegister::StackPointer)
+	{
+		m_stackRegister = postStackReg;
+		m_writeBuffer->WriteByteUnchecked(postStackReg);
+	}
+
+	if (opcode == 0x60/*RTS*/ || 
+	    opcode == 0x40/*RTI*/ ||
+	    opcode == 0x00/*BRK*/ ||
+	    opcode == 0x6C/*JMP (abs)*/ || 
+	    (opcode == 0x7C/*JMP (abs,X)*/ && m_cpu == CPU::CPU65C12))
+	{
+		// Write destination address
+		m_writeBuffer->WriteByteUnchecked((byte)postPC);
+		m_writeBuffer->WriteByteUnchecked((byte)(postPC >> 8));
+	}
+	else if ((opcodeTraits.MemoryAccess & (MemoryAccess::Read | MemoryAccess::Write)) != 0)
+	{
+		// Write memory access address
+		if (opcodeTraits.AddressingMode == AddressingMode::IndexedOrIndirect)
+		{
+			m_writeBuffer->WriteByteUnchecked((byte)memoryAddress);
+			m_writeBuffer->WriteByteUnchecked((byte)(memoryAddress >> 8));
+		}
+		else
+		{
+			assert(memoryAddress == ((operand2 << 8) | operand1));
+		}
+
+		// Write read / write values
+		if (!opcodeTraits.LoadOrStore)
+		{
+			if ((opcodeTraits.MemoryAccess & MemoryAccess::Read) != 0)
+			{
+				m_writeBuffer->WriteByteUnchecked(memoryReadValue);
+			}
+
+			if ((opcodeTraits.MemoryAccess & MemoryAccess::Write) != 0)
+			{
+				m_writeBuffer->WriteByteUnchecked(memoryWriteValue);
+			}
+		}
+	}
+
+	m_executionCount++;
+}
+
+bool PerfWriter::Initialise(const CHAR* psFileName)
+{
+	assert(m_pFile == nullptr);
+
+	m_error.Clear();
+	m_threadError.Clear();
+	m_writeBuffer->Clear();
+	m_sFileName = psFileName;
+	m_executionCount = 0;
+	m_lastOpcodeAddress = 0;
+
+	SetCPU();
+	InitOpcodeTraitsTable();
+	GetRegisters(&m_programCounter, &m_accumulator, &m_XRegister, &m_YRegister, &m_statusRegister, &m_stackRegister);
+	GetStackFrames(&m_stackFrames, &m_stackFrameCount);
+
+	try
+	{
+		CreateResources();
+
+		m_pFile = FileOpen(psFileName);
+		WriteHeaderChunk();
+		if (!Labels.empty())
+		{
+			WriteLabelsChunk();
+		}
+		WriteSnapshotChunk();
+		return true;
+	}
+	catch (std::exception& e)
+	{
+		m_error.Set(e.what());
+
+		FileClose(&m_pFile);
+		remove(psFileName);
+
+		DestroyResources();
+		return false;
+	}
+}
+
+bool PerfWriter::Close()
+{
+	assert(m_pFile != nullptr);
+
+	FlushReadWriteBuffers();
+
+	if (!m_error)
+	{
+		try
+		{
+			// Patch execution count
+			fseek(m_pFile, 16, SEEK_SET);
+			FileWriteInt32(m_pFile, m_executionCount);
+		}
+		catch (std::exception& e)
+		{
+			m_error.Set(e.what());
+		}
+	}
+
+	FileClose(&m_pFile);
+	if (m_error)
+	{
+		remove(m_sFileName.c_str());
+	}
+
+	DestroyResources();
+	return !m_error;
+}
+
+void PerfWriter::FlushReadWriteBuffers()
+{
+	if (m_bReadBufferLocked)
+	{
+		WaitForSingleObject(m_hReadBufferConsumedEvent, INFINITE);
+	}
+
+	if (SwapReadWriteBuffers())
+	{
+		WaitForSingleObject(m_hReadBufferConsumedEvent, INFINITE);
+		if (m_threadError)
+		{
+			m_error.Set(m_threadError);
+		}
+	}
+}
+
+bool PerfWriter::SwapReadWriteBuffers()
+{
+	if (m_bReadBufferLocked)
+	{
+		m_error.Set(".perf writer - can't keep up!");
+		return false;
+	}
+
+	if (m_threadError)
+	{
+		m_error.Set(m_threadError);
+		return false;
+	}
+
+	ResetEvent(m_hReadBufferConsumedEvent);
+
+	std::swap(m_readBuffer, m_writeBuffer);
+	m_writeBuffer->Clear();
+
+	m_bReadBufferLocked = true;
+	SetEvent(m_hReadBufferReadyEvent);
+	return true;
+}
+
+void PerfWriter::ThreadFunc()
+{
+	SetEvent(m_hStartupEvent);
+
+	bool bTerminate = false;
+	while (!bTerminate)
+	{
+		HANDLE hEvents[] = { m_hReadBufferReadyEvent, m_hShutdownEvent };
+		DWORD result = WaitForMultipleObjects(_countof(hEvents), hEvents, FALSE, INFINITE);
+
+		switch (result)
+		{
+		case WAIT_OBJECT_0 + 0: // Read buffer ready event
+			if (m_readBuffer->Size())
+			{
+				try
+				{
+					// Write execution chunk
+					WriteFileChunk("PFex", true/*compressed*/, *m_readBuffer);
+				}
+				catch (std::exception& e)
+				{
+					m_threadError.Set(e.what());
+				}
+			}
+			m_bReadBufferLocked = false;
+			ResetEvent(m_hReadBufferReadyEvent);
+			SetEvent(m_hReadBufferConsumedEvent);
+			break;
+
+		case WAIT_OBJECT_0 + 1: // Shutdown event
+			bTerminate = true;
+			break;
+
+		default:
+			bTerminate = true;
+			break;
+		}
+	}
+}
+
+unsigned int __stdcall PerfWriter::ThreadFunc(void* pParameter)
+{
+	PerfWriter* pInstance = static_cast<PerfWriter*>(pParameter);
+	if (pInstance != nullptr)
+	{
+		pInstance->ThreadFunc();
+	}
+	return 0;
+}
+
+const char* PerfWriter::FileName() const
+{
+	return m_sFileName.c_str();
+}
+
+const char* PerfWriter::ErrorString() const
+{
+	assert((bool)m_error);
+	return (const char*)m_error;
+}
