+//
+// file IO helpers
+//
+
+inline static FILE* FileOpen(const CHAR* psFileName)
+{
+    FILE* pFile = fopen(psFileName, "wb");
+    if (pFile == NULL)
+    {
+        throw std::exception(strerror(errno));
+    }
+    return pFile;
+}
+
+inline static void FileClose(FILE** pFile)
+{
+    if (*pFile != nullptr)
+    {
+        fclose(*pFile);
+        *pFile = nullptr;
+    }
+}
+
+inline static void FileWrite(FILE* pFile, const void* data, size_t size)
+{
+    if (fwrite(data, size, 1/*elementCount*/, pFile) != 1)
+    {
+        throw std::exception(strerror(errno));
+    }
+}
+
+inline static void FileWriteByte(FILE* pFile, byte value)
+{
+    FileWrite(pFile, &value, sizeof(value));
+}
+
+inline static void FileWriteInt32(FILE* pFile, int32_t value)
+{
+    FileWrite(pFile, &value, sizeof(value));
+}
+
+//
+// PerfWriter impl.
+//
+
+PerfWriter::PerfWriter() :
+    m_pFile(nullptr),
+    m_cpu(CPU::CPU6502),
+    m_executionCount(0),
+    m_lastOpcodeAddress(0),
+    m_readWriteBuffers{ BufferSize, BufferSize },
+    m_readBuffer(&m_readWriteBuffers[0]),
+    m_writeBuffer(&m_readWriteBuffers[1]),
+    m_bReadBufferLocked(false),
+    m_hThread(NULL),
+    m_hStartupEvent(NULL),
+    m_hShutdownEvent(NULL),
+    m_hReadBufferReadyEvent(NULL),
+    m_hReadBufferConsumedEvent(NULL),
+    m_cs{ 0 }
+{
+}
+
+PerfWriter::~PerfWriter()
+{
+    assert(m_pFile == nullptr);
+}
+
+void PerfWriter::SetCPU()
+{
+	switch (MachineType)
+	{
+	case Model::Master128:
+	case Model::MasterET:
+		m_cpu = CPU::CPU65C12;
+		break;
+
+	case Model::B:
+	case Model::IntegraB:
+	case Model::BPlus:
+	default:
+		m_cpu = CPU::CPU6502;
+		break;
+	}
+}
+
