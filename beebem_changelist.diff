+
+// .perf file writer
+class PerfWriter
+{
+public:
+	PerfWriter();
+	PerfWriter(const PerfWriter&) = delete;
+	PerfWriter& operator=(const PerfWriter&) = delete;
+	virtual ~PerfWriter();
