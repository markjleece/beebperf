+// Get memory page - used for performance capture - MJSL
+
+MemPageType BeebMemPage(int Address) {
+	if (MachineType == Model::B) {
+		if (Address >= 0x8000 && Address < 0xc000) {
+			if (PALRom[ROMSEL].Type == PALRomType::none) {
+				return (MemPageType)ROMSEL;
+			}
+			else {
+				return MemPage_Other;
+			}
+		}
+		else {
+			return MemPage_WholeRam;
+		}
+	}
+	else if (MachineType == Model::IntegraB) {
+		if (Address < 0x3000) return MemPage_WholeRam;
+		if (Address >= 0x8000 && Address < 0x8400 && Prvs8 && PrvEn) return MemPage_Private;
+		if (Address >= 0x8000 && Address < 0x9000 && Prvs4 && PrvEn) return MemPage_Private;
+		if (Address >= 0x9000 && Address < 0xb000 && Prvs1 && PrvEn) return MemPage_Private;
+		if (Address < 0x8000) {
+			if (ShEn) {
+				if (MemSel) {
+					return MemPage_WholeRam;
+				}
+				else {
+					return MemPage_ShadowRam;
+				}
+			}
+			else {
+				return MemPage_WholeRam;
+			}
+		}
+		if (Address >= 0x8000 && Address < 0xc000) {
+			if (PALRom[ROMSEL].Type == PALRomType::none) {
+				return (MemPageType)ROMSEL;
+			}
+			else {
+				return MemPage_Other;
+			}
+		}
+		if (Address < 0xfc00) return MemPage_WholeRam;
+		if (Address >= 0xff00) return MemPage_WholeRam;
+
+		if (Address == 0xfe3c)
+		{
+			switch (HidAdd)
+			{
+			case 0:
+			case 2:
+			case 4:
+			case 6:
+			case 7:
+			case 8:
+			case 9:
+			case 0xa:
+				return MemPage_Other; // CDP6818E clock
+			default:
+				return MemPage_Hidden;
+			}
+		}
+	}
+	else if (MachineType == Model::BPlus) {
+		if (Address < 0x3000) return MemPage_WholeRam;
+		if (Address < 0x8000 && Sh_Display && PrePC >= 0xc000 && PrePC < 0xe000) return MemPage_ShadowRam;
+		if (Address < 0x8000 && Sh_Display && MemSel && PrePC >= 0xa000 && PrePC < 0xb000) return MemPage_ShadowRam;
+		if (Address < 0x8000) return MemPage_WholeRam;
+		if (Address < 0xB000 && MemSel) return MemPage_Private;
+		if (Address >= 0x8000 && Address < 0xc000) {
+			if (PALRom[ROMSEL].Type == PALRomType::none) {
+				return (MemPageType)ROMSEL;
+			}
+			else {
+				return MemPage_Other;
+			}
+		}
+		if (Address < 0xfc00) return MemPage_WholeRam;
+		if (Address >= 0xff00) return MemPage_WholeRam;
+	}
+	else if (MachineType == Model::Master128 || MachineType == Model::MasterET) {
+		switch ((Address & 0xf000) >> 12) {
+		case 0:
+		case 1:
+		case 2:
+			return MemPage_WholeRam; // Low memory - not paged.
+		case 3:
+		case 4:
+		case 5:
+		case 6:
+		case 7:
+			if (!Sh_CPUX && !Sh_CPUE) return MemPage_WholeRam;
+			if (Sh_CPUX) return MemPage_ShadowRam;
+			if (Sh_CPUE && !Sh_CPUX) {
+				if (PrePC >= 0xc000 && PrePC < 0xe000) {
+					return MemPage_ShadowRam;
+				}
+				else {
+					return MemPage_WholeRam;
+				}
+			}
+			break;
+		case 8:
+			if (PrivateRAMSelect) {
+				return MemPage_Private;
+			}
+			else {
+				if (PALRom[ROMSEL].Type == PALRomType::none) {
+					return (MemPageType)ROMSEL;
+				}
+				else {
+					return MemPage_Other;
+				}
+			}
+			break;
+		case 9:
+		case 0xa:
+		case 0xb:
+			if (PALRom[ROMSEL].Type == PALRomType::none) {
+				return (MemPageType)ROMSEL;
+			}
+			else {
+				return MemPage_Other;
+			}
+			break;
+		case 0xc:
+		case 0xd:
+			if (FSRAMSelect) {
+				return MemPage_FilingSystemRam;
+			}
+			else {
+				return MemPage_WholeRam;
+			}
+			break;
+		case 0xe:
+			return MemPage_WholeRam;
+		case 0xf:
+			if (Address < 0xfc00 || Address >= 0xff00) { 
+				return MemPage_WholeRam; 
+			}
+			if ((ACCCON & 0x40) && Address >= 0xfc00 && Address < 0xff00) {
+				return MemPage_WholeRam;
+			}
+			break;
+
+		default:
+			return MemPage_Other;
+		}
+	}
+
+	return MemPage_Other;
+} /* BeebMemPage */
