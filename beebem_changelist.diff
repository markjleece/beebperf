+	};
+
+	struct Buffer
+	{
+	public:
+		Buffer(int capacity);
+		Buffer(const Buffer&) = delete;
+		Buffer& operator=(const Buffer&) = delete;
+		~Buffer();
+		void Write(const void* data, int size);
+		void WriteByte(byte value);
+		void WriteInt16(int16_t value);
+		void WriteInt32(int32_t value);
+		void WriteByteUnchecked(byte value);
+		void Clear();
+		int Size() const;
+		byte* Data() const;
+
+	private:
+		int m_capacity;
+		int m_size;
+		byte* m_data;
+	};
+
+	CPU m_cpu;
+	FILE* m_pFile;
+	std::string m_sFileName;
+	int m_executionCount;
+	int m_lastOpcodeAddress;
+	int m_programCounter;
+	byte m_accumulator;
+	byte m_XRegister;
+	byte m_YRegister;	
+	byte m_statusRegister;
+	byte m_stackRegister;
+	const StackFrame* m_stackFrames;
+	int m_stackFrameCount;
+
+	Error m_error;
+	Error m_threadError;
+
+	Buffer m_readWriteBuffers[2];
+	Buffer* m_readBuffer;
+	Buffer* m_writeBuffer;
+
+	HANDLE m_hThread;
+	HANDLE m_hStartupEvent;
+	HANDLE m_hShutdownEvent;
+	HANDLE m_hReadBufferReadyEvent;
+	HANDLE m_hReadBufferConsumedEvent;
+
+	CRITICAL_SECTION m_cs;
+
+	bool m_bReadBufferLocked;
+
+	enum ModifiedRegister
+	{
+		// Cycle count held in bits 0..3
+		Accumulator = 0x08,
+		XRegister = 0x10,
+		YRegister = 0x20,
+		StatusRegister = 0x40,
+		StackPointer = 0x80
+	};
+
+	enum AddressingMode
+	{
+		IndexedOrIndirect = 1
+	};
+
+	enum MemoryAccess
+	{
+		Read = 1,
+		Write = 2,
+	};
+
+	enum LoadOrStore
+	{
+		LDA = 1,
+		LDX = 2,
+		LDY = 3,
+		STA	= 4,
+		STX = 5,
+		STY = 6
+	};
+
+	struct OpcodeTraits
+	{
+		byte Size : 2; // 1, 2 or 3 bytes (including opcode)
+		byte AddressingMode : 1;
+		byte MemoryAccess : 2;
+		byte LoadOrStore : 1;
+	};
+
+	OpcodeTraits m_opcodeTraitsTable[256];
+
+	const static int FrameStartEventSize = 8;
+	const static int InterruptEventSize = 8;
+	const static int MaxInstructionSize = 17;
+	const static int BufferSize = 0x80000; // 512K
+
+	static unsigned int __stdcall ThreadFunc(void* pParameter);
+};
+
+extern PerfWriter* perfWriter;
+
+class AutoLock
+{
+public:
+	AutoLock(CRITICAL_SECTION* cs);
+	AutoLock(const AutoLock&) = delete;
+	AutoLock& operator=(const AutoLock&) = delete;
+	~AutoLock();
+private:
+	CRITICAL_SECTION* m_cs;
+};
+
+//
+// Inlines...
+//
+inline void PerfWriter_WriteFrameStartEvent(int offsetCycleCount, int startAddress, int displayScanline, byte displayField, bool splitScreen)
+{
+	if (perfWriter != nullptr)
+	{
+		perfWriter->WriteFrameStartEvent(offsetCycleCount, startAddress, displayScanline, displayField, splitScreen);
+	}
+}
+
+inline void PerfWriter_WriteInterruptEvent(
+	PerfWriter::InterruptType interruptType, int prePC, int postPC, byte cycleCount, byte stackStatusRegister)
+{
+	if (perfWriter != nullptr)
+	{
+		perfWriter->WriteInterruptEvent(interruptType, prePC, postPC, cycleCount, stackStatusRegister);
+	}
+}
+
+inline void PerfWriter_WriteInstruction(
+	int prePC, int postPC, byte opcode, byte cycleCount, 
+	byte postAccumulator, byte postXReg, byte postYReg, byte postPSR, byte postStackReg,
+	int memoryAddress, byte memoryReadValue, byte memoryWriteValue)
+{
+	if (perfWriter != nullptr)
+	{
+		perfWriter->WriteInstruction(
+			prePC, postPC, opcode, cycleCount,
+			postAccumulator, postXReg, postYReg, postPSR, postStackReg,
+			memoryAddress, memoryReadValue, memoryWriteValue);
+	}
+}
+
+inline PerfWriter::Buffer::Buffer(int capacity) :
+	m_capacity(capacity),
+	m_size(0)
+{
+	m_data = new byte[capacity];
+}
+
+inline PerfWriter::Buffer::~Buffer()
+{
+	delete[] m_data;
+}
+
+inline void PerfWriter::Buffer::WriteByteUnchecked(byte value)
+{
+	m_data[m_size++] = value;
+}
+
+inline void PerfWriter::Buffer::Write(const void* data, int size)
+{
+	if (m_size + size > m_capacity)
+	{
+		throw std::exception("buffer full!");
+	}
+	memcpy(m_data + m_size, data, size);
+	m_size += size;
+}
+
+inline void PerfWriter::Buffer::WriteByte(byte value)
+{
+	if (m_size == m_capacity)
+	{
+		throw std::exception("buffer full!");
+	}
+	m_data[m_size++] = value;
+}
+
+inline void PerfWriter::Buffer::WriteInt16(int16_t value)
+{
+	// Assumes little endian host architecture
+	if (m_size + 2 > m_capacity) 
+	{
+		throw std::exception("buffer full!");
+	}
+	*(int16_t*)(m_data + m_size) = value;
+	m_size += 2;
+}
+
+inline void PerfWriter::Buffer::WriteInt32(int32_t value)
+{
+	// Assumes little endian host architecture
+	if (m_size + 4 > m_capacity)
+	{
+		throw std::exception("buffer full!");
+	}
+	*(int32_t*)(m_data + m_size) = value;
+	m_size += 4;
+}
+
+inline void PerfWriter::Buffer::Clear()
+{
+	m_size = 0;
+}
+
+inline int PerfWriter::Buffer::Size() const
+{
+	return m_size;
+}
+
+inline byte* PerfWriter::Buffer::Data() const
+{
+	return m_data;
+}
+
+inline PerfWriter::Error::Error() :
+	m_bError(false)
+{
+}
+
+inline void PerfWriter::Error::Set(const Error& other)
+{
+	if (!m_bError)
+	{
+		m_bError = other.m_bError;
+		m_sError = other.m_sError;
+	}
+}
+
+inline void PerfWriter::Error::Set(const char* psError)
+{
+	if (psError == nullptr)
+	{
+		throw std::exception("psError == nullptr");
+	}
+
+	if (!m_bError)
+	{
+		m_bError = (psError[0] != '\0');
+		m_sError = psError;
+	}
+}
+
+inline void PerfWriter::Error::Clear()
+{
+	m_bError = false;
+	m_sError.clear();
+}
+
+inline PerfWriter::Error::operator bool() const
+{
+	return m_bError;
+}
+
+inline PerfWriter::Error::operator const char* () const
+{
+	return m_sError.c_str();
+}
+
+inline AutoLock::AutoLock(CRITICAL_SECTION* cs) : m_cs(cs)
+{
+	EnterCriticalSection(m_cs);
+}
+
+inline AutoLock::~AutoLock()
+{
+	LeaveCriticalSection(m_cs);
+}
+
+#endif
+
