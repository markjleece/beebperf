+static std::string FormatString(const char* format, ...)
+{
+	va_list args;
+	va_start(args, format);
+
+	std::string result;
+	const int length = _vscprintf(format, args) + 1/*null terminator*/;
+	char* buffer = new char[length];
+	if (buffer != nullptr)
+	{
+		vsprintf(buffer, format, args);
+		result = buffer;
+		delete[] buffer;
+	}
+
+	va_end(args);
+	return result;
+}
+
+void BeebWin::UpdatePerfCaptureMenu()
+{
+	EnableMenuItem(IDM_CAPTUREPERF, !IsCapturingPerf());
+	EnableMenuItem(IDM_ENDPERF, IsCapturingPerf());
+}
+
+void BeebWin::CapturePerf()
+{
+	char DefaultPath[MAX_PATH];
+	char FileName[MAX_PATH];
+	FileName[0] = '\0';
+
+	const char* filter = "Perf File (*.perf)\0*.perf\0";
+
+	m_Preferences.GetStringValue(CFG_PERF_PATH, DefaultPath);
+	GetDataPath(m_UserDataPath, DefaultPath);
+
+	FileDialog Dialog(m_hWnd, FileName, sizeof(FileName), DefaultPath, filter);
+
+	if (Dialog.Save())
+	{
+		// Add .perf extension
+		if (!HasFileExt(FileName, ".perf"))
+		{
+			strcat(FileName, ".perf");
+		}
+
+		if (m_AutoSavePrefsFolders)
+		{
+			GetPathFromFileName(FileName, DefaultPath, sizeof(DefaultPath));
+
+			m_Preferences.SetStringValue(CFG_PERF_PATH, DefaultPath);
+		}
+
+		EndPerfCapture();
+
+		perfWriter = new PerfWriter();
+
+		if (!perfWriter->Initialise(FileName))
+		{
+			std::string error = FormatString("Failed to create .perf file: %s, error: %s", perfWriter->FileName(), perfWriter->ErrorString());
+			Report(MessageType::Error, error.c_str());
+
+			delete perfWriter;
+			perfWriter = nullptr;
+		}
+	}
+}
+
+void BeebWin::EndPerfCapture()
+{
+	if (perfWriter != nullptr)
+	{
+		if (!perfWriter->Close())
+		{
+			std::string error = FormatString("An error occurred writing the .perf file: %s, error: %s", perfWriter->FileName(), perfWriter->ErrorString());
+			Report(MessageType::Error, error.c_str());
+		}
+
+		delete perfWriter;
+		perfWriter = nullptr;
+	}
+}
+
+bool BeebWin::IsCapturingPerf() const
+{
+	return perfWriter != nullptr;
+}
