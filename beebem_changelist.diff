+    m_lastOpcodeAddress(0),
+    m_programCounter(0),
+    m_accumulator(0),
+    m_XRegister(0),
+    m_YRegister(0),
+    m_statusRegister(0),
+    m_stackRegister(0),
+    m_stackFrames(nullptr),
+    m_stackFrameCount(0),
+    m_readWriteBuffers{BufferSize, BufferSize},
+    m_readBuffer(&m_readWriteBuffers[0]),
+    m_writeBuffer(&m_readWriteBuffers[1]),
+    m_bReadBufferLocked(false),
+    m_hThread(NULL),
+    m_hStartupEvent(NULL),
+    m_hShutdownEvent(NULL),
+    m_hReadBufferReadyEvent(NULL),
+    m_hReadBufferConsumedEvent(NULL),
+    m_cs{0}
+{
+}
+
+PerfWriter::~PerfWriter()
+{
+    assert(m_pFile == nullptr);
+}
+
+void PerfWriter::SetCPU()
+{
+	switch (MachineType)
+	{
+	case Model::Master128:
+	case Model::MasterET:
+		m_cpu = CPU::CPU65C12;
+		break;
+
+	case Model::B:
+	case Model::IntegraB:
+	case Model::BPlus:
+	default:
+		m_cpu = CPU::CPU6502;
+		break;
+	}
+}
